# ============================================================================
# Bulk Email Dry-Run Sender — configuration
# ALL defaults below are CONSERVATIVE STARTING VALUES, not trusted performance
# values. They must be observed/tuned at each scale (Constitution VI/VII).
# ============================================================================

# --- Core ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (business system of record) ---
DATABASE_URL=postgresql://mailblast:mailblast@postgres:5432/mailblast?schema=public
# Bounded backoff for the initial DB connection (do not trust depends_on alone)
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_BACKOFF_MS=1000

# --- Redis / BullMQ (reconstructible operational work only) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECT_MAX_RETRIES=10
REDIS_CONNECT_BACKOFF_MS=1000

# --- SMTP transport (Nodemailer pooled) — default dry-run target = Mailpit ---
# Never use localhost from inside the container; use the compose service name.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=20
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# Envelope From used for all dry-run messages
MAIL_FROM=dry-run@mailblast.local

# --- Preparation (keyset snapshot scan) ---
PREPARATION_BATCH_SIZE=500

# --- Dispatch / backpressure ---
DELIVERY_ENQUEUE_BATCH_SIZE=500
MAX_BUFFERED_QUEUE_JOBS=5000

# --- Workers / concurrency ---
# Single-process mode: number of BullMQ Worker instances started in-process.
# NOTE: MailService is ONE shared SMTP pool for the whole process (not
# per-worker) -- total concurrent job slots = WORKER_COUNT x WORKER_CONCURRENCY
# must stay <= SMTP_MAX_CONNECTIONS, or jobs merely queue inside Nodemailer's
# pool instead of running.
WORKER_COUNT=1
# Concurrency per delivery worker. WORKER_COUNT x WORKER_CONCURRENCY <= SMTP_MAX_CONNECTIONS.
WORKER_CONCURRENCY=20
# BullMQ global rate limit for the delivery queue (max jobs per duration).
# 200/100ms = ~2000/s ceiling, well above what WORKER_CONCURRENCY x SMTP pool can
# actually push -- acts as a safety valve, not the throughput bottleneck.
DELIVERY_RATE_LIMIT_MAX=200
DELIVERY_RATE_LIMIT_DURATION_MS=100

# --- Retry policy ---
MAX_DELIVERY_ATTEMPTS=3
RETRY_BACKOFF_MS=2000
# Comma-separated Nodemailer error codes classified NON-retryable (definitive
# pre-acceptance failures -> terminal FAILED immediately). Configurable per FR-023b.
NON_RETRYABLE_SMTP_CODES=EENVELOPE,EMESSAGE
# Comma-separated codes classified UNCERTAIN (acceptance may have occurred ->
# DELIVERY_UNKNOWN, never auto-retried).
UNCERTAIN_SMTP_CODES=ETIMEDOUT,ESOCKET
# Everything else = retryable pre-acceptance transient failure.

# --- Lease / recovery ---
# A live worker renews its IN_PROGRESS lease every LEASE_HEARTBEAT_MS. Recovery
# treats an IN_PROGRESS record as orphaned only after LEASE_STALENESS_MS elapses
# past the last renewal. Staleness must exceed a realistic SMTP round-trip.
LEASE_HEARTBEAT_MS=5000
LEASE_STALENESS_MS=30000
# Maintenance sweep cadence (dispatch/orphan/completion checks).
MAINTENANCE_INTERVAL_MS=5000

# --- Bounded queue job retention ---
REMOVE_ON_COMPLETE_AGE_S=3600
REMOVE_ON_COMPLETE_COUNT=1000
REMOVE_ON_FAIL_AGE_S=86400
REMOVE_ON_FAIL_COUNT=5000
